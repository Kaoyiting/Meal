# 複製成 .env 後供 Docker Compose 與本機開發使用。
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME=Meal Order API

# 本機開發使用 localhost；Compose 會覆寫為 postgres:5432。
POSTGRES_DB=order_service
POSTGRES_USER=order_user
POSTGRES_PASSWORD=order_password
DATABASE_URL=postgresql+asyncpg://order_user:order_password@localhost:5433/order_service

# 請換成自己的隨機長字串；Compose 啟動時必須設定。
JWT_SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 本機開發使用 localhost；Compose 會覆寫為 redis:6379。
REDIS_URL=redis://localhost:6380/0
REDIS_PASSWORD=
REDIS_DB=0

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
LOG_LEVEL=INFO
LOG_FORMAT=text

# 僅供整合測試。測試工具會拒絕非 test_* 名稱的資料庫。
TEST_DATABASE_URL=postgresql+asyncpg://test_user:test_password@localhost:5434/test_order_service
