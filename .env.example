# Order Service 環境變數設定範例
# 複製此檔案為 .env 並修改相應的值

# === 應用程式基本設定 ===
ENV=development
DEBUG=true
API_V1_STR=/api/v1
PROJECT_NAME=Order Service

# === 安全設定 ===
# 重要：在生產環境中務必更改這個密鑰！
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# === 資料庫設定 ===
# 本地開發環境 (直接連接)
DATABASE_URL=postgresql+asyncpg://order_user:order_password@localhost:5433/order_service

# Docker 環境 (容器間連接)
# DATABASE_URL=postgresql+asyncpg://order_user:order_password@postgres:5432/order_service

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# === Redis 設定 ===
# 本地開發環境
REDIS_URL=redis://localhost:6380

# Docker 環境
# REDIS_URL=redis://redis:6379

REDIS_PASSWORD=
REDIS_DB=0

# === RabbitMQ 設定 ===
# 本地開發環境
RABBITMQ_URL=amqp://order_user:order_password@localhost:5673/

# Docker 環境
# RABBITMQ_URL=amqp://order_user:order_password@rabbitmq:5672/

# === 記錄設定 ===
LOG_LEVEL=INFO
LOG_FORMAT=detailed

# === 外部服務設定 ===
# Menu Service
MENU_SERVICE_URL=http://localhost:8002

# User Service  
USER_SERVICE_URL=http://localhost:8003

# Payment Service
PAYMENT_SERVICE_URL=http://localhost:8004

# Notification Service
NOTIFICATION_SERVICE_URL=http://localhost:8005

# === Saga 設定 ===
SAGA_TIMEOUT_SECONDS=300
SAGA_RETRY_ATTEMPTS=3
SAGA_RETRY_DELAY_SECONDS=5

# === API 限制設定 ===
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# === 測試設定 ===
# 測試資料庫 (記憶體中或獨立測試 DB)
TEST_DATABASE_URL=postgresql+asyncpg://test_user:test_password@localhost:5433/test_order_service

# === 監控和追蹤 ===
ENABLE_METRICS=true
ENABLE_TRACING=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces